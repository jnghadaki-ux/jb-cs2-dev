<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads compiled CS2 files (vmdl_c, vmat_c, vtex_c) for the workshop scripts; not part of the plugin build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ValveResourceFormat" Version="20.0.6980" />
  </ItemGroup>
</Project>
