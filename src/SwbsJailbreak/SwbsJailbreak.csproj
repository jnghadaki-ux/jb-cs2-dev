<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- CounterStrikeSharp 1.0.376 targets .NET 10 -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SwbsJailbreak</AssemblyName>
    <RootNamespace>SwbsJailbreak</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Gdaki</Authors>
    <Description>Ultimate Jailbreak for CS2 (CounterStrikeSharp) - designed after HlStriker, SWBS development/lead admins</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the CounterStrikeSharp runtime on the server, so never copied to output -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="lang\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
