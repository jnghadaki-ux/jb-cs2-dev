<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      .NET 10: compiled against CounterStrikeSharp.API 1.0.376. CSS 1.0.369+ ships a .NET 10 runtime (hostfxr 10.x), so a
      current server needs a net10 plugin build. (1.0.368 was the last .NET 8 release.)
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SwbsJailbreak</AssemblyName>
    <RootNamespace>SwbsJailbreak</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Gdaki; enhanced with Claude Code</Authors>
    <Description>Ultimate Jailbreak for CS2 (CounterStrikeSharp) - designed after HlStriker, SWBS development/lead admins</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the CounterStrikeSharp runtime on the server, so never copied to output -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Shared points / store items on MySQL (configs/swbs_shared.json); MySqlConnector.dll ships next to the plugin -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SwbsJailbreak.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="lang\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- src/Swbs.Common: the Store, Zone Manager and BhopCheck shared byte-for-byte with the other SWBS repos -->
    <Compile Include="..\Swbs.Common\**\*.cs" Link="Common\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\Swbs.Common\lang\**\*.json" Link="lang\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
